# ==========================================================================
# KorisQuant AI Platform - configuration
# Copy to `.env` and adjust. Every value here is optional: with no .env at all
# the platform runs in hybrid mode using free Yahoo Finance data and falls back
# to its deterministic synthetic engine when the network is unavailable.
# ==========================================================================

# ------------------------------------------------------------- application
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ------------------------------------------------------------- data source
# hybrid  -> live providers first, synthetic fallback   (recommended)
# live    -> live only, error out when unavailable      (production)
# offline -> never touch the network, fully deterministic (CI / demo)
DATA_MODE=hybrid
NETWORK_TIMEOUT=8.0
CACHE_TTL_SECONDS=300
SYNTHETIC_SEED=42

# ------------------------------------------------------- authentication
# Every page and business endpoint requires a session. Only the landing page,
# the auth screen and /health are public. Set to false to reopen the platform.
REQUIRE_AUTH=true
# SESSION_MINUTES=720                 # 12 h default session
# SESSION_REMEMBER_MINUTES=43200      # 30 days with "remember me"

# ---- email delivery ------------------------------------------------------
# With no SMTP_HOST, verification and password-reset links are written to the
# server log and shown in the UI instead of being emailed. The tokens, expiry
# and single-use scoping are identical either way; only the transport changes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=KorisQuant AI <no-reply@korisquant.ai>
# PUBLIC_BASE_URL=http://localhost:8000

# !! SECRET_KEY must be changed from its default: it signs every session
#    token, so a known value means anyone can forge a login.

# ------------------------------------------------------ AI assistant (chat)
# The in-app assistant runs on Ollama, which exposes an OpenAI-compatible
# endpoint. The key is read server-side only and never sent to the browser
# (the frontend talks to /api/v1/chat, which adds the credential).
# Without a configured endpoint the platform runs exactly as before, minus the
# chat panel.
#
# --- Option A: Ollama Cloud ------------------------------------------------
# Get a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=...
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_FALLBACK_MODELS=gpt-oss:120b,nemotron-3-super,gemma4:31b
#
# Note: Ollama Cloud gates part of its catalogue behind a paid plan. Verified
# as available on the free tier (all with tool calling): gpt-oss:20b,
# gpt-oss:120b, nemotron-3-super, nemotron-3-ultra, nemotron-3-nano:30b,
# gemma4:31b, minimax-m3.
#
# --- Option B: local Ollama (no key, nothing leaves the machine) -----------
# Install from https://ollama.com/download, then:
#   ollama serve
#   ollama pull llama3.1          # any model with tool-calling support
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# (leave OLLAMA_API_KEY unset)
#
# The model MUST support tool calling: it is the assistant's only access to
# real platform data. A model without it would answer from imagination.
CHAT_ENABLED=true
# CHAT_RATE_LIMIT_PER_MIN=20      # per client IP
# CHAT_MAX_TOOL_ROUNDS=4          # tool -> model -> tool cycles before answering
# CHAT_TEMPERATURE=0.3            # low: the assistant reports figures, not prose

# --------------------------------------------------------- provider tokens
# Yahoo Finance needs no key. These unlock extra providers in the fallback chain.
# ALPHA_VANTAGE_API_KEY=
# FINNHUB_API_KEY=
# POLYGON_API_KEY=
# NEWSAPI_KEY=

# -------------------------------------------------------------- databases
# SQLite by default - zero setup. Swap for PostgreSQL in production.
# DATABASE_URL=postgresql+asyncpg://finai:finai@localhost:5432/finai
# SYNC_DATABASE_URL=postgresql://finai:finai@localhost:5432/finai
# REDIS_URL=redis://localhost:6379/0
# MONGO_URL=mongodb://localhost:27017/finai

# ------------------------------------------------------------------- ml
TORCH_DEVICE=cpu                 # cpu | cuda
DEFAULT_LOOKBACK=60
DEFAULT_HORIZON=5
TRAIN_EPOCHS=25
BATCH_SIZE=32

# -------------------------------------------------------------------- rl
RL_INITIAL_BALANCE=100000
RL_TRANSACTION_COST=0.001        # 10 bps per trade
RL_TRAIN_EPISODES=30

# ---------------------------------------------------------------- alerts
ALERT_PRICE_MOVE_PCT=3.0
ALERT_VOL_SPIKE_Z=2.5
ALERT_DRAWDOWN_PCT=10.0
# API reference (Swagger/ReDoc) is hidden from the site by default.
# Set to true only for local development or an internal environment.
EXPOSE_API_DOCS=false

SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15

# ------------------------------------------------------------------ cors
CORS_ORIGINS=*
